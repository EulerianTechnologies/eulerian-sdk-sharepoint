{
  "name": "eulerian-sharepoint",
  "version": "0.1.0",
  "description": "Eulerian Marketing Platform tracking for SharePoint Online modern pages (SPFx Application Customizer).",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EulerianTechnologies/eulerian-sdk-sharepoint.git"
  },
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "heft build --clean",
    "test": "heft test --clean",
    "package": "heft test --clean --production && heft package-solution --production",
    "harness:build": "tsc -p harness/tsconfig.json",
    "harness": "npm run harness:build && perl harness/harness.pl",
    "e2e": "npm run harness:build && playwright test -c harness/playwright.config.ts",
    "e2e:install": "playwright install chromium firefox",
    "version:check": "node scripts/check-version.mjs",
    "start": "heft start --clean",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack"
  },
  "dependencies": {
    "@microsoft/decorators": "1.24.1",
    "@microsoft/sp-application-base": "1.24.1",
    "@microsoft/sp-core-library": "1.24.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.1",
    "@microsoft/eslint-plugin-spfx": "1.24.1",
    "@microsoft/sp-module-interfaces": "1.24.1",
    "@microsoft/spfx-heft-plugins": "1.24.1",
    "@microsoft/spfx-web-build-rig": "1.24.1",
    "@playwright/test": "1.65.0",
    "@rushstack/heft": "1.3.2",
    "@types/jest": "30.0.0",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "serialize-javascript": "^7.1.3",
    "uuid": ">=11.1.1"
  }
}
